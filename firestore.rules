rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update, delete: if false;
    }

    // All transaction reads/writes go through server-side Admin SDK APIs.
    // This prevents clients from reading encrypted card payloads or modifying balances.
    match /cardTransactions/{transactionId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
